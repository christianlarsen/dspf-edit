{
  "Display Record Format": {
    "prefix": "dspf-record",
    "description": "Display file record format with a title constant",
    "body": [
      "     A          R ${1:SCREEN1}",
      "     A                                ${2:  1}${3: 30}'${4:Screen Title}'",
      "$0"
    ]
  },
  "Character Field": {
    "prefix": "field-char",
    "description": "Simple character field (type A)",
    "body": [
      "     A            ${1:FIELD1}${2:    }    ${3:30}A         TEXT('${4:Description}')",
      "$0"
    ]
  },
  "Zoned Numeric Field": {
    "prefix": "field-zoned",
    "description": "Zoned decimal field (type S)",
    "body": [
      "     A            ${1:FIELD1}${2:    }     ${3:7}S ${4:0}       TEXT('${5:Description}')",
      "$0"
    ]
  },
  "Date Field": {
    "prefix": "field-date",
    "description": "Date field (type L) with ISO format",
    "body": [
      "     A            ${1:FIELD1}${2:    }      L         DATFMT(*ISO)",
      "$0"
    ]
  },
  "Time Field": {
    "prefix": "field-time",
    "description": "Time field (type T) with ISO format",
    "body": [
      "     A            ${1:FIELD1}${2:    }      T         TIMFMT(*ISO)",
      "$0"
    ]
  },
  "Timestamp Field": {
    "prefix": "field-timestamp",
    "description": "Timestamp field (type Z)",
    "body": [
      "     A            ${1:FIELD1}${2:    }      Z         TEXT('${3:Description}')",
      "$0"
    ]
  },
  "Display Input Field": {
    "prefix": "dspf-input",
    "description": "Input-capable display field at line/position",
    "body": [
      "     A            ${1:FIELD1}${2:    }    ${3:10}A  B${4:  5}${5: 20}",
      "$0"
    ]
  },
  "Display Output Field": {
    "prefix": "dspf-output",
    "description": "Output-only display field at line/position",
    "body": [
      "     A            ${1:FIELD1}${2:    }    ${3:10}A  O${4:  5}${5: 20}",
      "$0"
    ]
  },
  "Screen Constant": {
    "prefix": "dspf-constant",
    "description": "Constant text at line/position",
    "body": [
      "     A                                ${1:  2}${2:  2}'${3:Label . . :}'",
      "$0"
    ]
  },
  "Window": {
    "prefix": "dspf-window",
    "description": "Window record format",
    "body": [
      "     A          R ${1:WINDOW1}${2:   }                WINDOW(${3:5} ${4:10} ${5:12} ${6:60})",
      "     A                                ${7:  2}${8:  3}'${9:Window title}'",
      "$0"
    ]
  },
  "Subfile": {
    "prefix": "dspf-subfile",
    "description": "Subfile record + subfile control record",
    "body": [
      "     A          R ${1:SFLREC}${2:    }                SFL",
      "     A            ${3:FIELD1}${4:    }    ${5:10}A  O${6:  8}${7:  5}",
      "     A          R ${8:SFLCTL}${9:    }                SFLCTL($1)",
      "     A                                      SFLSIZ(${10:0050})",
      "     A                                      SFLPAG(${11:0010})",
      "     A  ${12:50}                                  SFLDSP",
      "     A  ${13:51}                                  SFLDSPCTL",
      "     A  ${14:52}                                  SFLCLR",
      "     A                                      SFLEND(*MORE)",
      "$0"
    ]
  },
  "Function Key": {
    "prefix": "dspf-fkey",
    "description": "Command attention key with indicator",
    "body": [
      "     A                                      CA${1:03}(${2:03} '${3:Exit}')",
      "$0"
    ]
  },
  "File Header Comment": {
    "prefix": "dspf-header",
    "description": "Commented file header block",
    "body": [
      "     A*==============================================================",
      "     A* ${1:Description of this file}",
      "     A* ${2:Author / date}",
      "     A*==============================================================",
      "$0"
    ]
  }
}
